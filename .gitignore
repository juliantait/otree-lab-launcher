# Python caches
__pycache__/
*.py[cod]
*.egg-info/

# macOS
.DS_Store

# Editor / agent local state
.claude/

# Virtualenvs (the runners build one in ~/.otree-lab-launcher-venv, but ignore any local one too)
.venv/
venv/
env/

# data/ (at the repo root) holds BOTH shipped assets and your private runtime
# files. The shipped template (lab_info.example.json), the maps (data/maps/) and
# this folder's README ARE committed. Everything the launcher writes at runtime
# is NOT: real hosts/DB/admin (lab_info.json), saved configs which may hold
# plaintext passwords (presets.json + its corrupt-store rescue copies), the
# per-machine lab identity (lab.local), generated seat/label files (seats/) and
# the app-written logs. Ignore each of those precisely so the shipped files stay.
data/lab_info.json
data/presets.json
data/presets.json.broken-*
data/lab.local
data/seats/
data/*.log
# the launch history log and the once-a-day update-check cache (runtime state)
data/sessions.jsonl
data/update_check.json
# per-settings.py append locks the launcher keeps in its OWN data folder
data/locks/

# settings.py backups the launcher writes (those land in the user's own project)
*.bak
