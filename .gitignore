# Python caches
__pycache__/
*.py[cod]
*.egg-info/

# macOS
.DS_Store

# Editor / agent local state
.claude/

# Virtualenvs (the runners build one in ~/.otree-lab-launcher-venv, but ignore any local one too)
.venv/
venv/
env/

# data/ (at the repo root) is FULLY user-owned since 1.5.0: nothing in it ships
# (the example lab_info, the example maps and the data-folder README moved to
# app/assets/). The launcher writes everything in it at runtime: lab_info.json
# (the lab's settings), machine.json (this PC's databases + passwords),
# saved_configs.json (saved configs, which may hold passwords),
# launch_history.jsonl, seats/, locks/, retired/ (old files after an upgrade),
# update_check.json, logs and save leftovers. Ignore the whole folder.
/data/

# settings.py backups the launcher writes (those land in the user's own project)
*.bak

# local/ -- a SCRATCH folder at the repo root for anything you try out with the
# launcher inside this checkout: test studies, repos cloned with GitHub
# Organisation Sync (the clone folder picker opens here), exported files. The
# launcher creates it on demand; nothing in it is ever committed or pushed.
/local/

# Files the launcher writes wherever you point its save/folder pickers (which can
# open inside this checkout): exported one-click shortcuts (Launch_<config>.vbs /
# .command) and participant-PC shortcut bundles ("<lab> participant PC shortcuts/").
Launch_*.vbs
Launch_*.command
* participant PC shortcuts/
